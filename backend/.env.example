# Offline-first local PostgreSQL. DATABASE_URL is kept as a backward-compatible fallback.
LOCAL_DATABASE_URL=postgresql+asyncpg://rastarant_pos:password@localhost/rastarant_local
DATABASE_URL=postgresql+asyncpg://rastarant_pos:password@localhost/rastarant_local

# Optional cloud sync target. Use the direct Supabase PostgreSQL connection string.
# Example:
# SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=

SECRET_KEY=change-me-to-a-long-random-string
IMAGES_DIR=./uploads/menu_images

# Leave LOCAL_SERVER_IP blank to auto-detect the LAN address, or set it manually.
LOCAL_SERVER_IP=
BASE_URL=http://localhost:8000
SYNC_INTERVAL_SECONDS=30
SYNC_BATCH_SIZE=100
CREATE_SUPABASE_TABLES=true

# ngrok — get your free static domain at https://dashboard.ngrok.com/domains
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_STATIC_DOMAIN=your-static-domain.ngrok-free.app
